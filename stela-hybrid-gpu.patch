+        assert!(found.contains(&file), "{file} {found:?}");
+    }
+    assert!(with.unknown.is_empty());
+    // This build's bundle holds them exactly when it has the port.
+    assert_eq!(
+        objects().iter().any(|artifact| theirs(artifact.member)),
+        Ports::BUILT.intel
+    );
 }
 
